# =============================================================================
# Solej Hotel Network — zmienne konfiguracyjne
# =============================================================================
# Skopiuj ten plik jako .env i wypełnij wartości:
#   cp .env.example .env
#   chmod 600 .env             # ważne - zawiera hasła
#   vi .env                    # edytuj
#   ./render.sh                # generuje out/*.rsc
#
# UWAGA: NIE commituj .env do gita (jest w .gitignore).
# =============================================================================

# --- Hasła administratorów (każde urządzenie) --------------------------------
# Min. 16 znaków, generowane np. przez:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 20
LHG_ADMIN_PASSWORD=zmien-mnie-lhg-XXXXXXXXXXXX
HAP_ADMIN_PASSWORD=zmien-mnie-hap-XXXXXXXXXXXX
CAP1_ADMIN_PASSWORD=zmien-mnie-cap1-XXXXXXXXXXXX
CAP2_ADMIN_PASSWORD=zmien-mnie-cap2-XXXXXXXXXXXX

# --- Hasła WiFi --------------------------------------------------------------
# Min. 12 znaków dla Solej-priv, min. 12 dla Solej-Cams (kamery)
PRIV_WIFI_PASSWORD=zmien-mnie-priv-XXXXXXXX
CAMS_WIFI_PASSWORD=zmien-mnie-cams-XXXXXXXX

# --- LTE / Operator ----------------------------------------------------------
# T-Mobile PL: internet | Play: internet | Plus: plus | Orange: internet
APN=internet

# MAC adres ether1 hAP ax³ - pobierzesz po reset na hAP komendą:
#   /interface ethernet print
# Format: AA:BB:CC:DD:EE:FF (wielkie litery, dwukropki)
HAP_ETHER1_MAC=00:00:00:00:00:00

# --- Identity cAP-ów --------------------------------------------------------
# Te dwie nazwy pojawią się w System -> Identity i w logach CAPsMAN.
CAP1_IDENTITY=cap-pietro1
CAP2_IDENTITY=cap-pietro2
